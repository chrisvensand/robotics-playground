load("@rules_python//python:defs.bzl", "py_binary", "py_library")

py_library(
    name = "random_search",
    srcs = ["random_search.py"],
    visibility = ["//visibility:public"],
    deps = [
        "@pip//mujoco",
        "@pip//numpy",
    ],
)

py_binary(
    name = "train_cartpole",
    srcs = ["train_cartpole.py"],
    data = ["//assets/cartpole:cartpole_xml"],
    visibility = ["//visibility:public"],
    deps = [
        ":random_search",
        "@pip//mujoco",
        "@pip//numpy",
    ],
)

py_binary(
    name = "make_readme_gif",
    srcs = ["make_readme_gif.py"],
    data = [
        "//assets/cartpole:cartpole_xml",
        "//model/cartpole:weights",
    ],
    deps = [
        ":random_search",
        "@pip//imageio",
        "@pip//mujoco",
        "@pip//numpy",
    ],
)

py_binary(
    name = "eval_cartpole",
    srcs = ["eval_cartpole.py"],
    data = [
        "//assets/cartpole:cartpole_xml",
        "//model/cartpole:weights",
    ],
    deps = [
        ":random_search",
        "@pip//av",
        "@pip//mujoco",
        "@pip//numpy",
    ],
)
